            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Case\",\n  \"description\": null,\n  \"sale_price\": null,\n  \"price\": 590\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {

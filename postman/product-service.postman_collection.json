{
  "info": {
    "name": "Product Service",
    "description": "REST API of product-service.\n\n1. Start the service: `docker compose up --build`\n2. Select the **Product Service - Local** environment\n3. Run the whole collection (Runner) or send requests one by one. **Create product (all fields)** stores `productId` for the PATCH requests.\n\nEvery request sends `X-Request-ID` (random) and `X-User-ID` (`{{userId}}`), which end up in the logs and in `audit_logs`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-ID",
            "value": "{{$guid}}",
            "description": "Correlation ID, echoed back and stored in audit_logs"
          },
          {
            "key": "X-User-ID",
            "value": "{{userId}}",
            "description": "Actor recorded in audit_logs (default: anonymous)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness probe."
      }
    },
    {
      "name": "Create Product - POST /product",
      "item": [
        {
          "name": "Create product (all fields)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"successful = true, error_code empty\", () => {",
                  "    pm.expect(res.successful).to.eql(true);",
                  "    pm.expect(res.error_code).to.eql(\"\");",
                  "});",
                  "pm.test(\"X-Request-ID echoed\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.eql(pm.request.headers.get(\"X-Request-ID\")));",
                  "pm.test(\"data echoes the product\", () => {",
                  "    pm.expect(res.data.id).to.be.a(\"number\");",
                  "    pm.expect(res.data.name).to.eql(\"iPhone 17\");",
                  "    pm.expect(res.data.description).to.eql(\"Latest model\");",
                  "    pm.expect(res.data.sale_price).to.eql(39900);",
                  "    pm.expect(res.data.price).to.eql(42900);",
                  "});",
                  "pm.collectionVariables.set(\"productId\", res.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}",
                "description": "Correlation ID, echoed back and stored in audit_logs"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}",
                "description": "Actor recorded in audit_logs (default: anonymous)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 17\",\n  \"description\": \"Latest model\",\n  \"sale_price\": 39900,\n  \"price\": 42900\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            },
            "description": "Creates a product and stores its id in the `productId` collection variable for the PATCH requests."
          }
        },
        {
          "name": "Create product (only required fields)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"successful = true, error_code empty\", () => {",
                  "    pm.expect(res.successful).to.eql(true);",
                  "    pm.expect(res.error_code).to.eql(\"\");",
                  "});",
                  "pm.test(\"X-Request-ID echoed\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.eql(pm.request.headers.get(\"X-Request-ID\")));",
                  "pm.test(\"nullable fields are null\", () => {",
                  "    pm.expect(res.data.description).to.eql(null);",
                  "    pm.expect(res.data.sale_price).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}",
                "description": "Correlation ID, echoed back and stored in audit_logs"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}",
                "description": "Actor recorded in audit_logs (default: anonymous)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USB-C cable\",\n  \"price\": 290\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            },
            "description": "`description` and `sale_price` are nullable and may be omitted."
          }
        },

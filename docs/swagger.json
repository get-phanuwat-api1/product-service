{
    "swagger": "2.0",
    "info": {
        "description": "Product REST API (handler -\u003e service -\u003e repository) with Gin and PostgreSQL.",
        "title": "Product Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/product": {
            "post": {
                "description": "Create a new product. `description` and `sale_price` are nullable.\nA PRODUCT_CREATED audit log is recorded in the same transaction.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Create a new product",
                "operationId": "createProduct",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Correlation ID (generated when omitted, echoed in the response)",
                        "name": "X-Request-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Actor recorded in the audit log (default: anonymous)",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "description": "Product to create",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateProductRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.CreateProductResponse"
                        }
                    },
                    "400": {
                        "description": "INVALID_REQUEST_BODY | INVALID_NAME | INVALID_PRICE | INVALID_SALE_PRICE",
                        "schema": {
                            "$ref": "#/definitions/dto.CreateProductResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_SERVER_ERROR",
                        "schema": {
                            "$ref": "#/definitions/dto.CreateProductResponse"
                        }
                    }
                }
            }
        },
        "/product/{id}": {
            "patch": {
                "description": "Only keys present in the body are overwritten.\nOmit a key to keep its current value; send `null` to clear `description` / `sale_price`.\n`name` and `price` may be omitted but must not be `null`.\nA PRODUCT_UPDATED audit log (before/after) is recorded when a value actually changes.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Partially update a product by ID",
                "operationId": "patchProductByID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Correlation ID (generated when omitted, echoed in the response)",
                        "name": "X-Request-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Actor recorded in the audit log (default: anonymous)",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "integer",
                        "description": "Product ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to update",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.PatchProductRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.PatchProductResponse"
                        }
                    },
                    "400": {
                        "description": "INVALID_PRODUCT_ID | INVALID_REQUEST_BODY | INVALID_NAME | INVALID_PRICE | INVALID_SALE_PRICE",
                        "schema": {
                            "$ref": "#/definitions/dto.PatchProductResponse"
                        }
                    },
                    "404": {
                        "description": "PRODUCT_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/dto.PatchProductResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_SERVER_ERROR",
                        "schema": {
                            "$ref": "#/definitions/dto.PatchProductResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CreateProductRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "x-nullable": true,
                    "example": "Latest model"
                },
                "name": {
                    "type": "string",
                    "x-nullable": "false",
                    "example": "iPhone 17"
                },
                "price": {
                    "type": "number",
                    "x-nullable": "false",
                    "example": 42900
                },
                "sale_price": {
                    "type": "number",
                    "x-nullable": true,
                    "example": 39900
                }
            }
        },
        "dto.CreateProductResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.ProductData"
                        }
                    ],
                    "x-nullable": true
                },
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.PatchProductRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "x-nullable": true,
                    "example": "Updated description"
                },
                "name": {
                    "type": "string",
                    "example": "iPhone 17 Pro"
                },
                "price": {
                    "type": "number",
                    "example": 41900
                },
                "sale_price": {
                    "type": "number",
                    "x-nullable": true,
                    "example": 38900
                }
            }
        },
        "dto.PatchProductResponse": {
            "type": "object",
            "properties": {
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.ProductData": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "x-nullable": true,
                    "example": "Latest model"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "iPhone 17"
                },
                "price": {
                    "type": "number",
                    "example": 42900
                },
                "sale_price": {
                    "type": "number",
                    "x-nullable": true,
                    "example": 39900
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    }
}